  8.             local cp "`cp' P`m'"
  9.         }
 10.     }
 11.     if "`cp'" != "" {
 12.         esttab `cp' using "Tabla_Obj3_anual_`a'_`hoy'.rtf",                  ///
>             b(3) se(3) star(* 0.10 ** 0.05 *** 0.01)                         ///
>             keep(punt_global:*) noomitted coeflabels(`rot')                  ///
>             mtitles("M1a" "M1" "M2" "M3" "M3ctx")                            ///
>             title("Progresión de modelos, cohorte `a'")                      ///
>             addnotes("M1a: gradiente socioeconómico con sexo y edad; M1: bloque individual 
> completo." ///
