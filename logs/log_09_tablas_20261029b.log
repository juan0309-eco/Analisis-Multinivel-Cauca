. 
. capture estimates clear

. local cols ""

. foreach a in 2018 2019 2020 2021 2022 2023 {
  2.     * Coeficiente de la media de sede en M3ctx, para verificar βc (Kreft)
.     scalar bc_ctx = .
  3.     capture estimates use "M3ctx_`a'.ster"
  4.     if _rc == 0 scalar bc_ctx = _b[c_inse_prom_sede]
  5. 
.     capture estimates use "M3cwc_`a'.ster"
  6.     if _rc != 0 {
  7.         display as error "No se encontró M3cwc_`a'.ster: se omite la cohorte."
  8.         continue
  9.     }
 10.     * Contraste βw = βb (Tabla 15) y efectos aleatorios, antes de reescribir
.     quietly test cwc_inse = c_inse_prom_sede
 11.     scalar chi_c = r(chi2)
 12.     scalar p_c   = r(p)
 13.     scalar bw = _b[cwc_inse]
 14.     scalar bb = _b[c_inse_prom_sede]
 15.     scalar bpl = _b[pct_planta]
 16.     scalar bru = _b[rural]
 17.     foreach k in 1 2 {
 18.         scalar lns`k' = _b[lns`k'_1_1:_cons]
 19.         scalar lns`k'_se = _se[lns`k'_1_1:_cons]
 20.     }
 21.     scalar lnse = _b[lnsig_e:_cons]
 22.     scalar lnse_se = _se[lnsig_e:_cons]
 23. 
.     _post_ctx
 24. 
.     estadd scalar chi_c   = chi_c
 25.     estadd scalar p_c     = p_c
 26.     estadd scalar n_est   = `nest_`a''
 27.     estadd scalar n_sede  = `nsed_`a''
 28.     estadd scalar n_mcpio = `nmun_`a''
 29.     estadd scalar v_mcpio = exp(2*lns1)
 30.     estadd scalar v_sede  = exp(2*lns2)
 31.     estadd scalar v_resid = exp(2*lnse)
 32.     estadd scalar sd_mcpio = exp(lns1)
 33.     estadd scalar sd_mcpio_se = exp(lns1)*lns1_se
 34.     estadd scalar sd_sede = exp(lns2)
 35.     estadd scalar sd_sede_se = exp(lns2)*lns2_se
 36.     estadd scalar sd_resid = exp(lnse)
 37.     estadd scalar sd_resid_se = exp(lnse)*lnse_se
 38.     estadd scalar ll_m1  = `ll_`a''
 39.     estadd scalar aic_m1 = `aic_`a''
 40.     estadd scalar bic_m1 = `bic_`a''
 41.     * Panel B (cálculo derivado): coeficiente × DE de su variable / DE del puntaje
.     estadd scalar de_bw = bw*sdw_`a'/sdp_`a'
 42.     estadd scalar de_bb = bb*sdb_`a'/sdp_`a'
 43.     estadd scalar de_pl = bpl*sd_b_planta/sdp_`a'
 44.     estadd scalar de_ru = bru/sdp_`a'
 45.     estimates store F`a'
 46.     local cols "`cols' F`a'"
 47.     display "`a'  βc = " %7.4f _b[ctx] " (" %6.4f _se[ctx] ")   M3ctx: " %7.4f bc_ctx
 48. }

