. ********************************************************************************
. * PROGRAMA: añade βc = βb − βw a la estimación de M3cwc en memoria
. ********************************************************************************
. capture program drop _post_ctx

. program define _post_ctx, eclass
  1.     tempname b V bf Vf A bn Vn
  2.     matrix `b' = e(b)
  3.     matrix `V' = e(V)
  4.     local N = e(N)
  5.     matrix `bf' = `b'[1, "punt_global:"]
  6.     matrix `Vf' = `V'["punt_global:", "punt_global:"]
  7.     local k  = colsof(`bf')
  8.     local jw = colnumb(`bf', "punt_global:cwc_inse")
  9.     local jb = colnumb(`bf', "punt_global:c_inse_prom_sede")
 10.     if missing(`jw') | missing(`jb') {
 11.         display as error "M3cwc no tiene cwc_inse o c_inse_prom_sede."
 12.         exit 111
 13.     }
 14.     matrix `A' = I(`k') \ J(1, `k', 0)
 15.     matrix `A'[`k' + 1, `jw'] = -1
 16.     matrix `A'[`k' + 1, `jb'] =  1
 17.     matrix `bn' = (`A' * `bf'')'
 18.     matrix `Vn' = `A' * `Vf' * `A''
 19.     local nombres : colnames `bf'
 20.     local nombres `nombres' ctx
 21.     matrix colnames `bn' = `nombres'
 22.     matrix colnames `Vn' = `nombres'
 23.     matrix rownames `Vn' = `nombres'
 24.     ereturn post `bn' `Vn', obs(`N')
 25.     ereturn local cmd "c11_ctx"
 26. end

