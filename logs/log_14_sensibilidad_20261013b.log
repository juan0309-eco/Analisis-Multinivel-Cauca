>         libros_26omas trabaja_mas20 internet_hogar computador_hogar
. 
.     display _newline "--- Faltantes de Nivel 2 en m = 0, a nivel de estudiante ---"
.     mi xeq 0: misstable summarize ln_matricula ratio_alumnos_docente ///
