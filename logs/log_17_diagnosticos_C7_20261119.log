. ********************************************************************************
. * [2.1] EFECTOS PREDICHOS, IDENTIFICADOS POR SU NIVEL
. ********************************************************************************
. predict double re_*, reffects

. describe re_*

Variable      Storage   Display    Value
    name         type    format    label      Variable label
---------------------------------------------------------------------------------------------
re_1            double  %10.0g                BLUP r.e. for mcpio_id: _cons
re_2            double  %10.0g                BLUP r.e. for mcpio_id: R.year
re_3            double  %10.0g                BLUP r.e. for sede_id: _cons
re_4            double  %10.0g                BLUP r.e. for sede_anio: _cons

. 
. * El efecto permanente del municipio es la unica variable re_* constante
. * dentro de mcpio_id. Se busca, no se supone su posicion.
. local re_m ""

. foreach v of varlist re_* {
  2.     tempvar s
  3.     quietly bysort mcpio_id: egen double `s' = sd(`v')
  4.     quietly count if `s' > 1e-8 & !missing(`s')
  5.     if r(N) == 0 & "`re_m'" == "" local re_m `v'
  6.     drop `s'
  7. }

. display _newline "Efecto permanente del municipio: `re_m'"

Efecto permanente del municipio: re_1

. assert "`re_m'" != ""

. rename `re_m' re_mcpio

. 
