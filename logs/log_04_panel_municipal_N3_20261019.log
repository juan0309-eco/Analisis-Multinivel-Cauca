. * --- Versiones per cápita ---
. generate double inversion_pc = inversion_r     / pob

. generate double sgp_pae_pc   = sgp_pae_r       / pob

. generate double sgp_total_pc = sgp_total_r     / pob

. generate double inv_fut_pc   = inv_fut_r       / pob

