  3. }
  Intencional V2b  15_gradiente_medicion.do         1
  Intencional V2b  15a_ensayo_gradiente.do          1
  Intencional V2b  15b_lecturas.do                  1
  Intencional V2b  15c_figuras.do                   1

. 
. * Falso positivo de V4: es la reconstruccion de la variable de sistema
. _clasif Intencional V4 "07b_reparar_y_unir_v2.do" "_mi_miss" ///
