. local ncadena : word count `cadena'

. local nfalta = 0

. foreach f of local cadena {
  2.     capture confirm file "$RAIZ_DO/`f'"
  3.     if _rc != 0 {
  4.         local ++nfalta
  5.         quietly set obs `=_N + 1'
  6.         quietly replace archivo  = "`f'" in l
  7.         quietly replace linea    = 0 in l
  8.         quietly replace regla    = "V8" in l
  9.         quietly replace gravedad = "Error" in l
 10.         quietly replace texto    = "script de la cadena ausente en Definitivo" in l
 11.         quietly replace estado   = "Abierto" in l
 12.         display as error "  V8: falta `f'"
 13.     }
 14. }

