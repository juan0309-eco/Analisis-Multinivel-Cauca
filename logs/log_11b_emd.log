. 
. tempname pe

. postfile `pe' str12 modelo str20 variable ///
>     double b se z p emd using "EMD_C1.dta", replace
(file EMD_C1.dta not found)

. 
. foreach m in ML3 ML3_reml ML3_robust ML3b {
  2. 
.     capture confirm file "`m'.ster"
  3.     if _rc != 0 {
  4.         display as error _newline "`m'.ster no existe en el directorio; se omite."
  5.         continue
  6.     }
  7. 
.     capture noisily estimates use "`m'.ster"
  8.     if _rc != 0 {
  9.         display as error "No se pudo leer `m'.ster. Codigo: " _rc
 10.         continue
 11.     }
 12. 
.     display _newline "{hline 70}"
 13.     display "--- `m' ---"
 14.     display "{hline 70}"
 15. 
.     foreach v in tasa_homicidios ln_coca ln_inversion_pc {
 16. 
.         capture noisily lincom sdw_`v' * `v'_dev
 17.         if _rc != 0 {
 18.             display as error "  `v'_dev no esta en `m'. Se omite."
 19.             continue
 20.         }
 21. 
.         scalar b_v   = r(estimate)
 22.         scalar se_v  = r(se)
 23.         scalar z_v   = b_v / se_v
 24.         scalar p_v   = 2*normal(-abs(z_v))
 25.         scalar emd_v = 2.802 * se_v
 26. 
.         display "  `v': b = " %9.4f b_v "   EE = " %8.4f se_v ///
>             "   EMD = " %8.4f emd_v
 27. 
.         post `pe' ("`m'") ("`v'") (b_v) (se_v) (z_v) (p_v) (emd_v)
 28.     }
 29. }

