. * ----------------------------------------------------------------------
. * [2.2] Tablas extensas: la progresión completa de cada cohorte
. * ----------------------------------------------------------------------
. foreach a in 2018 2019 2020 2021 2022 2023 {
  2. 
.     capture estimates clear
  3.     local cols ""
  4.     foreach m in M1a M1 M2 M3 M3ctx {
  5.         capture estimates use "`m'_`a'.ster"
  6.         if _rc == 0 {
  7.             estimates store P`m'
  8.             local cols "`cols' P`m'"
  9.         }
 10.     }
 11. 
.     if "`cols'" != "" {
 12.         esttab `cols' using "Tabla_Obj3_anual_`a'.rtf", replace              ///
>             b(3) se(3) star(* 0.10 ** 0.05 *** 0.01)                         ///
>             keep(punt_global:*) noomitted                                    ///
>             mtitles("M1a" "M1" "M2" "M3" "M3ctx")                            ///
>             title("Progresión de modelos, cohorte `a'")                      ///
>             addnotes("M1a estima el gradiente socioeconómico total; M1 el gradiente neto de
>  la dotación del hogar." ///
>                      "M3ctx añade el INSE medio de la sede, con lo que el coeficiente indiv
> idual pasa a medir el efecto dentro de la sede." ///
>                      "Estimación por máxima verosimilitud sobre 20 imputaciones múltiples."
> ) ///
>             nogaps compress
 13.         display "Generada: Tabla_Obj3_anual_`a'.rtf"
 14.     }
 15. }
