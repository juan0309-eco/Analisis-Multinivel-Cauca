. capture estimates clear

. local cols_cwc ""

. foreach a in 2018 2019 2020 2021 2022 2023 {
  2.     capture estimates use "M3cwc_`a'.ster"
  3.     if _rc == 0 {
  4.         estimates store C`a'
  5.         local cols_cwc "`cols_cwc' C`a'"
  6.     }
  7. }

. 
. if "`cols_cwc'" != "" {
.     esttab `cols_cwc' using "Tabla_Obj3_cwc_anual.rtf", replace              ///
>         b(3) se(3) star(* 0.10 ** 0.05 *** 0.01) noomitted                   ///
>         keep(cwc_inse c_inse_prom_sede)                                      ///
>         mtitles("2018" "2019" "2020" "2021" "2022" "2023")                   ///
>         title("Especificación con centrado al clúster, por cohorte")         ///
>         addnotes("cwc_inse mide la ventaja del estudiante frente a sus propios compañeros d
> e sede." ///
>                  "c_inse_prom_sede mide el efecto de estudiar en una sede de mayor nivel so
> cioeconómico." ///
>                  "Ambos modelos incluyen el bloque individual, el institucional y el índice
>  de vulnerabilidad.") ///
