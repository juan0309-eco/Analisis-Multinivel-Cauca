. ********************************************************************************
. * [2] OAXACA-BLINDER, 2018 FRENTE A 2023
. ********************************************************************************
. * `oaxaca` no admite mixed ni mi estimate de forma fiable, de modo que se corre
. * dentro de un bucle sobre imputaciones y se combina por Rubin en el bloque [3].
. *
. * ORDEN OBLIGATORIO: mi extract PRIMERO, egen/generate DESPUES. Al reves se
. * crean variables sin registrar en el conjunto mi, que es el error E4 de C5.
. *
. * Cuatro especificaciones por imputacion:
. *   A  principal       sin z_posgrado, CON estu_inse_individual
. *   B  sin INSE        sin z_posgrado, sin estu_inse_individual
. *   C  con z_posgrado  solo para medir cuanto mueve (C7, apartado 4.1)
. *   D  sin INSE y con z_posgrado
. 
. if `hacer_oaxaca' == 1 {
. 
.     display _newline(2) "{hline 78}"
.     display "[2] DESCOMPOSICION DE OAXACA-BLINDER, 2018 FRENTE A 2023"
.     display "{hline 78}"
. 
.     capture which oaxaca
.     if _rc != 0 {
.         capture ssc install oaxaca, replace
.         if _rc != 0 {
.             display as error "No se pudo instalar oaxaca. Instalarlo a mano y"
.             display as error "volver a correr SOLO este bloque."
.             exit 601
.         }
.     }
. 
.     timer clear 4
.     timer on 4
. 
.     tempname po
.     postfile `po' int m str12 espec str16 componente ///
>         double b se using "C3_oaxaca_`hoy'.dta", replace
. 
.     forvalues m = 1/5 {
  2. 
.         display _newline(2) "{hline 78}"
  3.         display "IMPUTACION `m'"
  4.         display "{hline 78}"
  5. 
.         use "C3_Base_Trabajo_`hoy'.dta", clear
  6.         mi extract `m', clear
  7. 
.         keep if inlist(year, 2018, 2023)
  8.         generate byte y2023 = (year == 2023)
  9. 
.         quietly count
 10.         display "Observaciones de las dos cohortes: " r(N)
 11. 
.         forvalues e = 1/4 {
 12. 
.             if `e' == 1 {
 13.                 local nom   "A_principal"
 14.                 local lista "estu_inse_individual $v_n1 $v_n2_oax"
 15.             }
 16.             if `e' == 2 {
 17.                 local nom   "B_sinINSE"
 18.                 local lista "$v_n1 $v_n2_oax"
 19.             }
 20.             if `e' == 3 {
 21.                 local nom   "C_conposg"
 22.                 local lista "estu_inse_individual $v_n1 $v_n2"
 23.             }
 24.             if `e' == 4 {
 25.                 local nom   "D_sinINSE_posg"
 26.                 local lista "$v_n1 $v_n2"
 27.             }
 28. 
.             display _newline "--- Oaxaca, m = `m', especificacion `nom' ---"
 29. 
.             capture noisily oaxaca punt_global `lista',      ///
>                 by(y2023) pooled vce(cluster sede_id) detail
 30. 
.             if _rc != 0 {
 31.                 display as error "oaxaca fallo (codigo " _rc "). Reintentando"
 32.                 display as error "con `relax'. SI ESTE REINTENTO FUNCIONA, hay"
 33.                 display as error "una variable omitida en una de las dos"
 34.                 display as error "cohortes: identificarla ANTES de interpretar."
 35.                 capture noisily oaxaca punt_global `lista',  ///
>                     by(y2023) pooled vce(cluster sede_id) detail relax
 36.             }
 37. 
.             if _rc == 0 {
 38.                 foreach c in difference explained unexplained {
 39.                     capture post `po' (`m') ("`nom'") ("`c'") ///
>                         (_b[`c']) (_se[`c'])
 40.                 }
 41.                 * Contribuciones detalladas que la fila 4 de C3 necesita.
.                 foreach c in edad repitente estu_inse_individual {
 42.                     capture post `po' (`m') ("`nom'") ("exp_`c'") ///
>                         (_b[explained:`c']) (_se[explained:`c'])
 43.                 }
 44.             }
 45.             else {
 46.                 display as error "`nom' no se estimo en m = `m'."
 47.             }
 48.         }
 49.     }
. 
.     postclose `po'
. 
.     timer off 4
.     display _newline "--- Tiempo del bloque [2] ---"
.     timer list 4
. }

. 
. 
. ********************************************************************************
. * [3] COMBINACION DE RUBIN Y RESUMEN
. ********************************************************************************
. * Qbar = media de los Q_m
. * Ubar = media de las varianzas dentro de cada imputacion (se^2)
. * B    = varianza muestral de los Q_m, con divisor M-1
. * T    = Ubar + (1 + 1/M) * B
. * nu   = (M-1) * (1 + Ubar / ((1 + 1/M) * B))^2
. *
. * Con M = 5 los grados de libertad pueden salir muy bajos. Se reportan, y el
. * rango entre imputaciones se reporta junto a ellos, como hizo C1.
. 
. if `hacer_rubin' == 1 {
. 
.     display _newline(2) "{hline 78}"
.     display "[3] COMBINACION DE RUBIN SOBRE LAS CINCO IMPUTACIONES"
.     display "{hline 78}"
. 
.     capture confirm file "C3_oaxaca_`hoy'.dta"
.     if _rc != 0 {
.         display as error "No se encuentra C3_oaxaca_`hoy'.dta. Correr el [2]."
.         exit 601
.     }
. 
.     use "C3_oaxaca_`hoy'.dta", clear
. 
.     generate double u = se^2
. 
.     display _newline "Espec.        Componente         Qbar       EE(T)" ///
>         "      t      gl       p     min       max"
. 
.     levelsof espec, local(especs)
.     foreach e of local especs {
  2.         foreach c in difference explained unexplained ///
>                      exp_edad exp_repitente exp_estu_inse_individual {
  3. 
.             quietly count if espec == "`e'" & componente == "`c'"
  4.             local M = r(N)
  5.             if `M' < 2 continue
  6. 
.             quietly summarize b if espec == "`e'" & componente == "`c'"
  7.             scalar qbar = r(mean)
  8.             scalar Bv   = r(Var)
  9.             scalar bmin = r(min)
 10.             scalar bmax = r(max)
 11. 
.             quietly summarize u if espec == "`e'" & componente == "`c'"
 12.             scalar ubar = r(mean)
 13. 
.             scalar Tv = ubar + (1 + 1/`M')*Bv
 14.             scalar sev = sqrt(Tv)
 15.             scalar tv  = qbar/sev
 16. 
.             scalar nu = .
 17.             if Bv > 0 {
 18.                 scalar nu = (`M'-1) * (1 + ubar/((1 + 1/`M')*Bv))^2
 19.             }
 20.             scalar pv = .
 21.             if !missing(nu) scalar pv = 2*ttail(nu, abs(tv))
 22. 
.             display %-13s "`e'" %-18s "`c'" ///
>                 %10.3f qbar %10.3f sev %8.2f tv ///
>                 %8.1f nu %8.4f pv %8.3f bmin %10.3f bmax
 23.         }
 24.     }
. 
.     display _newline "{hline 78}"
.     display "LECTURA. La fila 4 de C3 se decide con el SIGNO de exp_repitente:"
.     display "repetir la prueba SUMA entre 3,9 y 8,5 puntos [Tabla 8], de modo"
.     display "que la caida de repitentes del 16,2 % al 10,7 % [Tabla 3] debe"
.     display "aparecer con contribucion NEGATIVA a la diferencia 2023-2018."
.     display "Si sale positiva, revisar la direccion de by(y2023) antes de"
.     display "escribir una sola linea del informe."
.     display ""
.     display "Ninguna contribucion individual se promueve a hallazgo. La Oaxaca"
.     display "es descriptiva por la regla impresa en el bloque [0.9]."
.     display "{hline 78}"
. }

