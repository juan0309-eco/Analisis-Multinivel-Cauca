. ********************************************************************************
. * [1] LECTURA DE LAS HOJAS ANUALES
. ********************************************************************************
. * Las hojas de 2018 a 2020 traen 8 columnas y las de 2021 a 2023 traen 10.
. * El archivo largo se guarda como .dta permanente para poder inspeccionarlo
. * después sin volver a leer el Excel ni depender de un tempfile.
. 
. local primero = 1

. 
. foreach y in 2018 2019 2020 2021 2022 2023 {
  2. 
.     display _newline "{hline 78}"
  3.     display "LEYENDO HOJA `y'_tic"
  4.     display "{hline 78}"
  5. 
.     capture noisily import excel "Panel_tic.xlsx", sheet("`y'_tic") firstrow clear
  6.     if _rc != 0 {
  7.         display as error "No se pudo leer la hoja `y'_tic. Año omitido."
  8.         continue
  9.     }
 10. 
.     quietly count
 11.     display "Filas leídas: " r(N)
 12. 
.     rename *, lower
 13. 
.     * Presencia de las columnas de desglose por ubicación.
.     local tiene_desglose = 0
 14.     capture confirm variable sedecom_cant_presta
 15.     if _rc == 0 {
 16.         capture confirm variable sedecom_cant_sede
 17.         if _rc == 0 local tiene_desglose = 1
 18.     }
 19.     if `tiene_desglose' == 1 {
 20.         display "Hoja `y': incluye el desglose PRESTA / SEDE."
 21.     }
 22.     else {
 23.         display "Hoja `y': sin desglose PRESTA / SEDE (esperado en 2018-2020)."
 24.         quietly generate double sedecom_cant_presta = .
 25.         quietly generate double sedecom_cant_sede   = .
 26.     }
 27. 
.     keep sede_codigo periodo_id periodo_anio equipocom_id equipocom_nombre ///
>          sedecom_cantidad sedecom_cant_sinuso sedecom_cant_presta sedecom_cant_sede
 28. 
.     capture confirm string variable sede_codigo
 29.     if _rc != 0 {
 30.         quietly tostring sede_codigo, replace format(%20.0f) force
 31.     }
 32.     quietly replace sede_codigo = trim(sede_codigo)
 33.     rename sede_codigo cole_cod_dane_sede
 34. 
.     quietly destring periodo_id periodo_anio equipocom_id sedecom_cantidad   ///
>         sedecom_cant_sinuso sedecom_cant_presta sedecom_cant_sede,           ///
>         replace force
 35. 
.     rename periodo_anio year
 36. 
.     * ------------------------------------------------------------------
.     * Diagnósticos de la hoja
.     * ------------------------------------------------------------------
.     display _newline "--- Olas de recolección (periodo_id) y años ---"
 37.     tabulate periodo_id year, missing
 38. 
.     display _newline "--- Tipos de equipo ---"
 39.     tabulate equipocom_nombre, missing
 40. 
.     quietly duplicates tag cole_cod_dane_sede year equipocom_id, generate(_dup)
 41.     quietly count if _dup > 0
 42.     display _newline "Filas con sede-año-tipo repetido: " r(N)
 43.     drop _dup
 44. 
.     quietly count if sedecom_cant_sinuso > sedecom_cantidad & ///
>                      !missing(sedecom_cant_sinuso, sedecom_cantidad)
 45.     display "Filas donde SIN USO supera a CANTIDAD: " r(N)
 46.     quietly count if sedecom_cantidad == 0 & sedecom_cant_sinuso > 0 & ///
>                      !missing(sedecom_cant_sinuso)
 47.     display "Filas con CANTIDAD = 0 y SIN USO > 0: " r(N)
 48.     quietly count if sedecom_cantidad == 0 & sedecom_cant_sinuso == 0
 49.     display "Filas con CANTIDAD = 0 y SIN USO = 0: " r(N) ///
>             "  (si es 0, la fuente nunca registra ausencia total)"
 50. 
.     if `tiene_desglose' == 1 {
 51.         generate double _chk = sedecom_cant_presta + sedecom_cant_sede
 52.         quietly count if abs(_chk - sedecom_cantidad) > 0.001 & !missing(_chk)
 53.         display "Filas donde PRESTA + SEDE != CANTIDAD: " r(N) ///
>                 "  (debe ser 0 si la lectura es correcta)"
 54.         drop _chk
 55.     }
 56. 
.     quietly drop if missing(cole_cod_dane_sede) | cole_cod_dane_sede == ""
 57. 
.     if `primero' == 1 {
 58.         quietly save "TIC_largo_2018_2023.dta", replace
 59.         local primero = 0
 60.     }
 61.     else {
 62.         quietly append using "TIC_largo_2018_2023.dta"
 63.         quietly save "TIC_largo_2018_2023.dta", replace
 64.     }
 65. }

