. *------------------------------------------------------------------------------
. * Programas de lectura (usan los resultados posteados por mi estimate)
. *------------------------------------------------------------------------------
. capture program drop rep_corr

. program define rep_corr
  1.     args et
  2.     local a   = _b[atr2_1_1_2:_cons]
  3.     local s   = _se[atr2_1_1_2:_cons]
  4.     local sdb = _b[lns2_1_1:_cons]
  5.     local sds = _se[lns2_1_1:_cons]
  6.     local z   = invnormal(0.975)
  7.     display as text _newline "[`et']"
  8.     display as text "  DE de la pendiente = " %7.4f exp(`sdb') "   IC95% [" %7.4f exp(`s
> db'-`z'*`sds') "; " %7.4f exp(`sdb'+`z'*`sds') "]"
  9.     display as text "  Correlación        = " %7.4f tanh(`a') "   IC95% [" %7.4f tanh(`a
> '-`z'*`s') "; " %7.4f tanh(`a'+`z'*`s') "]"
 10.     if tanh(`a'-`z'*`s') > 0 | tanh(`a'+`z'*`s') < 0 {
 11.         display as result "  REGLA M4: el IC de la correlación EXCLUYE el cero."
 12.     }
 13.     else {
 14.         display as result "  REGLA M4: el IC de la correlación INCLUYE el cero."
 15.     }
 16. end

. 
. capture program drop rep_m5

. program define rep_m5
  1.     args et
  2.     quietly test c.cwc_inse#c.pct_planta c.cwc_inse#c.indice_vuln
  3.     local pj = r(p)
  4.     quietly test c.cwc_inse#c.pct_planta
  5.     local pa = r(p)
  6.     quietly test c.cwc_inse#c.indice_vuln
  7.     local pb = r(p)
  8.     local pmin = min(`pa',`pb')
  9.     local pmax = max(`pa',`pb')
 10.     local h1 = min(1, 2*`pmin')
 11.     local h2 = min(1, max(`h1', `pmax'))
 12.     if `pa' <= `pb' {
 13.         local ha = `h1'
 14.         local hb = `h2'
 15.     }
 16.     else {
 17.         local ha = `h2'
 18.         local hb = `h1'
 19.     }
 20.     display as text _newline "[`et']"
 21.     display as text "  cwc_inse x pct_planta   : coef " %7.4f _b[c.cwc_inse#c.pct_planta
> ] " (EE " %6.4f _se[c.cwc_inse#c.pct_planta] ")  p = " %6.4f `pa' "  p Holm = " %6.4f `ha'
 22.     display as text "  cwc_inse x indice_vuln  : coef " %7.4f _b[c.cwc_inse#c.indice_vul
> n] " (EE " %6.4f _se[c.cwc_inse#c.indice_vuln] ")  p = " %6.4f `pb' "  p Holm = " %6.4f `hb
> '
 23.     display as text "  Contraste conjunto      : p = " %6.4f `pj'
 24.     if `pj' >= 0.05 {
 25.         display as result "  REGLA M5: contraste conjunto >= 0,05 -> sin heterogeneidad 
> detectable; M5 pasa a anexo como exploratorio."
 26.     }
 27.     else {
 28.         if min(`ha',`hb') < 0.05 {
 29.             display as result "  REGLA M5: conjunto < 0,05 y al menos una interacción su
> pera Holm -> se reporta solo la que la supera."
 30.         }
 31.         else {
 32.             display as result "  REGLA M5: conjunto < 0,05 pero ninguna supera Holm -> e
> videncia conjunta no atribuible a una interacción; exploratoria."
 33.         }
 34.     }
 35. end

