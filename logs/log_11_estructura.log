.     local fiscales  "ln_inv_fut_pc ln_inv_fut_pc_x ln_ing_trib_pc"
.     local etiquetas "R5_inv_fut_b R5b_inv_fut_dep_b R6_ing_trib_b"
.     local k = 1
.     foreach f of local fiscales {
  2.         local nom : word `k' of `etiquetas'
  3.         capture confirm variable `f'_dev
  4.         if _rc == 0 {
  5.             display _newline "--- `nom' ---"
  6.             mi estimate, dots post: mixed punt_global c_inse $v_n1 $v_n2  ///
>                 tasa_homicidios_bar tasa_homicidios_dev                   ///
>                 ln_coca_bar ln_coca_dev                                   ///
>                 `f'_bar `f'_dev ib2018.year $RE , reml
  7.             estimates save "`nom'.ster", replace
  8.             display "Observaciones utilizadas: " e(N)
  9.             lincom `f'_dev
 10.         }
 11.         else {
 12.             display as error "`f'_dev no esta en la base; se omite `nom'."
 13.             display as error "Correr el 04 v4 y el 07c antes de esta prueba."
 14.         }
 15.         local ++k
 16.     }

