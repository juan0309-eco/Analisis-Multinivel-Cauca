. capture program drop _fila

. program define _fila
  1.     args modelo archivo var
  2.     capture estimates use "`archivo'"
  3.     if _rc != 0 {
  4.         display as error "  No se encontro `archivo'"
  5.         exit
  6.     }
  7.     capture scalar _b0 = _b[`var']
  8.     if _rc != 0 {
  9.         display "  " %-10s "`modelo'" %-22s "`var'" "   (no esta en el modelo)"
 10.         exit
 11.     }
 12.     scalar _s0 = _se[`var']
 13.     scalar _p0 = 2*normal(-abs(_b0/_s0))
 14.     display "  " %-10s "`modelo'" %-22s "`var'" %10.4f _b0 %10.4f _s0 %9.4f _p0
 15. end

